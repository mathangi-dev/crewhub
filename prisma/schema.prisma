generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  ORGANIZER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  CANCELLED
  COMPLETED
}

enum WageType {
  HOURLY
  DAILY
}

enum ApplicationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  REJECTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  LATE
  ABSENT
  NO_SHOW
}

// RECORDED = organizer entered UPI details. CONFIRMED = worker confirmed receipt. Nobody else can set CONFIRMED.
enum PaymentStatus {
  PENDING
  RECORDED
  CONFIRMED
  DISPUTED
}

enum FeeStatus {
  PENDING
  PAID
  WAIVED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role
  status           AccountStatus     @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workerProfile    WorkerProfile?
  organizerProfile OrganizerProfile?
  events           Event[]
  applications     Application[]
  notifications    Notification[]
  tickets          SupportTicket[]   @relation("TicketOwner")
  assignedTickets  SupportTicket[]   @relation("TicketAssignee")
  reportsMade      Report[]          @relation("Reporter")
  reportsAgainst   Report[]          @relation("ReportedUser")
  auditLogs        AuditLog[]

  @@index([role, status])
}

model WorkerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone               String?
  upi                 String?
  address             String?
  area                String?
  city                String?
  pincode             String?
  latitude            Decimal? @db.Decimal(9, 6)
  longitude           Decimal? @db.Decimal(9, 6)
  radiusKm            Int      @default(15)
  nearbyNotif         Boolean  @default(true)
  skills              Json?
  experience          String?  @db.Text
  preferredCategories Json?
  emailNotif          Boolean  @default(true)
  pushNotif           Boolean  @default(true)
  remindNotif         Boolean  @default(true)
}

model OrganizerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgName     String
  phone       String?
  description String? @db.Text
  verified    Boolean @default(false)
}

model Event {
  id                  String        @id @default(cuid())
  organizerId         String
  organizer           User          @relation(fields: [organizerId], references: [id])
  title               String
  description         String        @db.Text
  category            String
  venue               String
  city                String
  latitude            Decimal?      @db.Decimal(9, 6)
  longitude           Decimal?      @db.Decimal(9, 6)
  posterUrl           String?
  startsAt            DateTime
  endsAt              DateTime
  applicationDeadline DateTime
  status              EventStatus   @default(DRAFT)
  suspendedReason     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  jobs                EventJob[]
  applications        Application[]
  platformFee         PlatformFee?
  reports             Report[]

  @@index([status, startsAt])
  @@index([organizerId, status])
  @@index([city])
}

model EventJob {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  vacancies       Int
  substituteCount Int           @default(0)
  wageType        WageType
  wage            Decimal       @db.Decimal(10, 2)
  requiredSkills  Json?
  eligibility     String?       @db.Text
  applications    Application[]

  @@index([eventId])
}

model Application {
  id               String             @id @default(cuid())
  eventId          String
  eventJobId       String
  workerId         String
  event            Event              @relation(fields: [eventId], references: [id])
  eventJob         EventJob           @relation(fields: [eventJobId], references: [id])
  worker           User               @relation(fields: [workerId], references: [id])
  status           ApplicationStatus
  waitlistPosition Int?
  isSubstitute     Boolean            @default(false)
  createdAt        DateTime           @default(now())
  cancelledAt      DateTime?
  offers           ReplacementOffer[]
  attendance       Attendance?
  payment          WorkerPayment?

  // One role per worker per event: prevents duplicates and double-booking
  @@unique([workerId, eventId])
  @@index([eventJobId, status, createdAt])
}

model ReplacementOffer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        OfferStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  respondedAt   DateTime?

  @@index([status, expiresAt])
  @@index([applicationId])
}

model Attendance {
  id            String           @id @default(cuid())
  applicationId String           @unique
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        AttendanceStatus
  checkInAt     DateTime?
  checkOutAt    DateTime?
  note          String?
}

model WorkerPayment {
  id                String        @id @default(cuid())
  applicationId     String        @unique
  application       Application   @relation(fields: [applicationId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  upiReference      String?
  paidAt            DateTime?
  confirmedAt       DateTime?
  deadlineAt        DateTime?
  remindedAt        DateTime?
  overdueNotifiedAt DateTime?
  disputeNote       String?
  createdAt         DateTime      @default(now())

  @@index([status, deadlineAt])
}

model PlatformFee {
  id         String    @id @default(cuid())
  eventId    String    @unique
  event      Event     @relation(fields: [eventId], references: [id])
  baseAmount Decimal   @db.Decimal(10, 2)
  rate       Decimal   @default(0.10) @db.Decimal(5, 4)
  feeAmount  Decimal   @db.Decimal(10, 2)
  status     FeeStatus @default(PENDING)
  receiptRef String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model SupportTicket {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation("TicketOwner", fields: [userId], references: [id])
  assigneeId String?
  assignee   User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  subject    String
  message    String       @db.Text
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  reason         String       @db.Text
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
